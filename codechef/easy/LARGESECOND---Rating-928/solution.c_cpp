#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, mx=0, smx=0;
        cin >> n;
        int a[n];
        for (int i = 0; i < n; i++) {
            cin >> a[i];
            if (a[i] > mx) {
                smx = mx;
                mx = a[i];

            } else if (a[i] > smx && a[i] < mx) {
                smx = a[i];
            }
            // your code goes here
        }
        cout << smx + mx << endl;
    }
    return 0;
}